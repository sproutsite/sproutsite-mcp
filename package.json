{
  "name": "sproutsite-mcp",
  "version": "0.1.1",
  "private": true,
  "description": "Read-only MCP server for Sproutsite documentation",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "verify:snapshot": "node dist/src/main.js --verify-snapshot",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:client": "node dist/test/client-smoke.js",
    "import:snapshot": "node dist/scripts/import-snapshot.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}
